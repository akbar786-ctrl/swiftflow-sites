// ============================================================================
// EURO 2028 - Power Query parameters
// Create both in Power BI Desktop: Home > Transform data > Manage Parameters > New
//   Name: pSubmissionsFolder   Type: Text   e.g. C:\EURO2028\Submissions
//         Folder holding the completed force collection workbooks (*.xlsx).
//   Name: pReferenceFile       Type: Text   e.g. C:\EURO2028\Reference\E28_Reference_Tables.xlsx
//         Full path to the reference workbook generated by build_all.py.
// SharePoint: replace Folder.Files(pSubmissionsFolder) in 03_Submissions.pq with
//   SharePoint.Files("https://<tenant>.sharepoint.com/sites/<site>", [ApiVersion = 15])
// and filter on [Folder Path]; replace File.Contents(pReferenceFile) in 01_fnRef.pq
// with the matching SharePoint file [Content].
// ============================================================================
"C:\EURO2028\Submissions" meta [IsParameterQuery = true, Type = "Text", IsParameterQueryRequired = true]
