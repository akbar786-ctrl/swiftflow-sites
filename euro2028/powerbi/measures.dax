// ============================================================================
// EURO 2028 - DAX measures. Create a table "_Measures" and add each measure.
// Relationships: docs/03_data_model.md.  Rules: RefParameter[RuleSet]
// (LEGACY by default = identical to the backup calculation workbook).
// Costs are calculated per row in Power Query (FactDeployed, FactMAPackage,
// FactCalendar); measures aggregate them so every slicer works.
// ============================================================================

// ---------------------------------------------------------------- Quantities
Officers = SUM ( FactDeployed[Officers] )
Officer Hours = SUM ( FactDeployed[ToDHours] ) + SUM ( FactDeployed[XHHours] )
Normal ToD Hours = SUM ( FactDeployed[ToDHours] )
Extra Hours = SUM ( FactDeployed[XHHours] )
PSU Units (Force Supplied) = CALCULATE ( SUM ( FactInput[NUM] ), FactInput[RowType] = "PSU_COUNT" )
PSU Units (Mutual Aid) = SUM ( FactMAPackage[Units] )
MA Packages Charged = SUM ( FactMAPackage[PackagesCharged] )
Peak Day Officers = MAXX ( VALUES ( DimRelativeDay[DayCode] ), [Officers] )

// -------------------------------------------------------------------- Costs
Officer Cost = SUM ( FactDeployed[Cost] )
Normal ToD Cost = SUM ( FactDeployed[ToDCost] )
Extra Hours Cost = SUM ( FactDeployed[XHCost] )
MA Package Cost = SUM ( FactMAPackage[Cost] )
Total Cost = [Officer Cost] + [MA Package Cost]
Force Supplied Cost = CALCULATE ( [Officer Cost], FactDeployed[SupplyCode] = "FS" )
Mutual Aid Cost = CALCULATE ( [Officer Cost], FactDeployed[SupplyCode] = "MA" ) + [MA Package Cost]
Uncosted Officer Hours = CALCULATE ( [Officer Hours], ISBLANK ( FactDeployed[Cost] ) )

// ------------------------------------------------- Match Day (per fixture)
// Fixtures are not set (D-01): Match Day figures are PER FIXTURE at the
// selected risk level. Slice by DimRisk and DimRelativeDay.
MD Officers per Fixture = CALCULATE ( [Officers], DimResource[Collection] = "MD" )
MD Cost per Fixture = CALCULATE ( [Total Cost], DimResource[Collection] = "MD" )

// What-if: RefFixturePlan = planned fixtures per host force per risk level
MD Planned Cost =
    SUMX (
        RefFixturePlan,
        RefFixturePlan[Fixtures]
            * CALCULATE (
                [MD Cost per Fixture],
                TREATAS ( { RefFixturePlan[Force] }, DimForce[Force] ),
                TREATAS ( { RefFixturePlan[RiskCode] }, DimRisk[RiskCode] )
            )
    )

// ---------------------------------------------------- Wider Tournament
WT Daily Officers = CALCULATE ( [Officers], DimResource[Collection] = "WT" )
WT Daily Cost = CALCULATE ( [Total Cost], DimResource[Collection] = "WT" )
WT Tournament Cost =
    SUMX ( VALUES ( DimRisk[RiskCode] ), CALCULATE ( [WT Daily Cost] ) * CALCULATE ( MAX ( DimRisk[WTDays] ) ) )
WT Tournament Officer Days =
    SUMX ( VALUES ( DimRisk[RiskCode] ), CALCULATE ( [WT Daily Officers] ) * CALCULATE ( MAX ( DimRisk[WTDays] ) ) )

// ------------------------------------------- Calendar (once fixtures set)
Calendar Officers = CALCULATE ( SUM ( FactCalendar[Officers] ), FactCalendar[Kind] = "Officer" )
Calendar MA Units = CALCULATE ( SUM ( FactCalendar[Officers] ), FactCalendar[Kind] = "Package" )
Calendar Cost = SUM ( FactCalendar[Cost] )
Peak Daily Officers = MAXX ( VALUES ( DimDate[Date] ), [Calendar Officers] )
Fixtures in Range =
    CALCULATE ( DISTINCTCOUNT ( RefFixture[FixtureID] ), USERELATIONSHIP ( RefFixture[MatchDate], DimDate[Date] ) )

// --------------------------------- Command Team & Planning, Other Resources
Command Team Cost = SUM ( FactCommandTeam[Cost] )
Other Resources Cost = SUM ( FactOtherResources[Cost FY 2027-28] ) + SUM ( FactOtherResources[Cost FY 2028-29] )

// Grand total for a force / nation: calendar MD (if fixtures set) or planned MD,
// plus WT tournament, Command Team and Other Resources
Grand Total Cost =
    VAR _md = IF ( ISEMPTY ( FactCalendar ), [MD Planned Cost], [Calendar Cost] )
    RETURN _md + [WT Tournament Cost] + [Command Team Cost] + [Other Resources Cost]

// ------------------------------------------------------ Capacity and gaps
Capacity = SUM ( RefCapacity[AvailableOfficers] )
Demand Peak = IF ( ISEMPTY ( FactCalendar ), [Peak Day Officers], [Peak Daily Officers] )
Capacity Gap = IF ( ISBLANK ( [Capacity] ), BLANK (), [Capacity] - [Demand Peak] )
Capacity Utilisation % = DIVIDE ( [Demand Peak], [Capacity] )

// --------------------------------------------- Equipment (needs OI-05)
// RefEquipmentRatio[Basis] = "Per officer" or "Per unit"
Equipment Required =
    SUMX (
        RefEquipmentRatio,
        RefEquipmentRatio[Ratio]
            * CALCULATE (
                IF ( RefEquipmentRatio[Basis] = "Per unit", [PSU Units (Force Supplied)] + [PSU Units (Mutual Aid)], [Officers] ),
                TREATAS ( { RefEquipmentRatio[ResourceID] }, DimResource[ResourceID] )
            )
    )

// --------------------------------------------- Scenario uplifts (needs OI-06)
Scenario Additional Officers =
    VAR _s = SELECTEDVALUE ( RefScenarioUplift[Scenario] )
    RETURN
        IF ( ISBLANK ( _s ), BLANK (),
            SUMX ( FILTER ( ALL ( RefScenarioUplift ), RefScenarioUplift[Scenario] = _s ),
                IF ( RefScenarioUplift[UpliftType] = "Percent",
                    RefScenarioUplift[Value] * CALCULATE ( [Officers], TREATAS ( { RefScenarioUplift[Portfolio] }, DimResource[Portfolio] ) ),
                    RefScenarioUplift[Value] ) ) )
Officers incl. Scenario = [Officers] + [Scenario Additional Officers]

// ---------------------------------------------------------- Data quality
DQ Errors = CALCULATE ( COUNTROWS ( DataQuality ), DataQuality[Severity] = "Error" )
DQ Warnings = CALCULATE ( COUNTROWS ( DataQuality ), DataQuality[Severity] = "Warning" )
Forces Submitted = CALCULATE ( DISTINCTCOUNT ( Submissions[ForceKey] ), Submissions[IsCurrent] = TRUE () )
Forces With Errors = CALCULATE ( DISTINCTCOUNT ( DataQuality[ForceKey] ), DataQuality[Severity] = "Error" )
Sections Complete % =
    DIVIDE (
        CALCULATE ( DISTINCTCOUNT ( FactInputCell[SectionKey] ), FactInputCell[SectionStatus] IN { "Complete", "Not required" } ),
        DISTINCTCOUNT ( FactInputCell[SectionKey] )
    )

// ---------------------------------------- ROUTE B (backup workbooks)
WB MD Officers = SUM ( WB_FactMD[Officers] )
WB MD Cost = SUM ( WB_FactMD[Cost] )
WB WT Daily Cost = SUM ( WB_FactWT[CostPerDay] )
WB WT Tournament Cost = SUM ( WB_FactWT[TournamentCost] )
WB Command Team Cost = CALCULATE ( SUM ( WB_FactOtherPages[Cost] ), WB_FactOtherPages[Page] = "Command Team & Planning" )
WB Other Resources Cost = CALCULATE ( SUM ( WB_FactOtherPages[Cost] ), WB_FactOtherPages[Page] = "Other Resources" )
WB Grand Total Cost = [WB MD Cost] + [WB WT Tournament Cost] + [WB Command Team Cost] + [WB Other Resources Cost]

// ------------------------------------------- Reconciliation (Route A = B)
// With the same return and fixtures, these must be 0 (RuleSet = LEGACY).
Check: MD Cost A minus B = [Calendar Cost] - [WB MD Cost]
Check: WT Cost A minus B = [WT Tournament Cost] - [WB WT Tournament Cost]
